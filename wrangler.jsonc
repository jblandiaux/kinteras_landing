{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinteras-landing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "assets": {
    // Lets the Worker read built files itself; used only for /video/* below.
    "binding": "ASSETS",
    // The landing is one HTML entry point; anything that is not a built file is
    // rewritten to index.html so /privacy resolves on a cold load, not just on
    // client-side navigation.
    "not_found_handling": "single-page-application",
    // Explicit rather than relying on the automatic navigation-header heuristic:
    // without it a request to /api/early-access that looks like a navigation
    // would be answered with index.html instead of reaching the Worker.
    // /summon/* is the PostHog reverse proxy. Without it listed here the SPA
    // fallback would answer analytics requests with index.html.
    // /video/* goes through the Worker for byte-range support: asset serving
    // answers `Range` with a full 200, and iOS Safari then refuses to play.
    "run_worker_first": ["/api/*", "/summon/*", "/video/*"]
  },
  // Explicit, not left to the default. Adding a `routes` entry silently flips
  // this to false, which takes the workers.dev URL down -- and until the apex
  // domain is attached, that URL is the only way to reach the site.
  "workers_dev": true,
  // Custom Domains rather than Routes: Cloudflare owns the DNS record and the
  // edge certificate for each hostname. A Route would still need a DNS record
  // pointing at some origin, which is precisely what was returning 521 here.
  "routes": [
    { "pattern": "kinteras.app", "custom_domain": true },
    { "pattern": "www.kinteras.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    // The Brevo list to add signups to. Not a secret; the API key is, and lives
    // in `wrangler secret put BREVO_API_KEY`. With either missing the endpoint
    // still records signups in D1 and simply skips the push.
    "BREVO_LIST_ID": "6"
  },
  // Per-IP throttle on the signup endpoint. A real visitor submits once or
  // twice; this stops a script from flooding D1 and, through it, the Brevo
  // list. Lives here rather than as a dashboard rule so it cannot be forgotten
  // on a fresh deploy. `namespace_id` is any account-unique integer.
  "ratelimits": [
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinteras-landing",
      "database_id": "3c1a9856-a4d5-420b-8b9d-3fb3f652994d"
    }
  ]
}
